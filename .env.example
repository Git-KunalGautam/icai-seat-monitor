ICAI_URL=https://icaionlineregistration.org/launchbatchdetail.aspx
DEFAULT_REGION=Central
DEFAULT_POU=JAIPUR
DEFAULT_COURSE=Advanced (ICITSS) MCS Course
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
NOTIFY_ON_SEAT_INCREASE=true
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
MAX_RETRIES=3
# false only when an unusable machine proxy is configured; TLS stays verified.
HTTP_TRUST_ENV=true
STATE_BACKEND=local
STATE_PATH=data/local_state.json
